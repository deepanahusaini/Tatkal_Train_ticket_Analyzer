# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must remain 3000 in AI Studio preview)
PORT="3000"

# RAIL_DATA_MODE: "DEMO" (clearly labeled simulated feed) or "AUTHORIZED_API"
RAIL_DATA_MODE="DEMO"

# Optional Authorized Indian Railway API Provider (leave unset to run in DEMO MODE)
RAIL_API_BASE_URL=""
RAIL_API_KEY=""

# Optional Notification Integrations (Server-Side)
TELEGRAM_BOT_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
