rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Primitives
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'deepanshu0saini@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidClass(val) {
      return val is string && val.size() <= 4 && val in ['1A', '2A', '3A', '3E', 'CC', 'EC', 'SL', '2S'];
    }

    function isValidQuota(val) {
      return val is string && val.size() <= 4 && val in ['TQ', 'PT', 'GN', 'LD', 'SS'];
    }

    function isValidStationCode(val) {
      return val is string && val.size() >= 2 && val.size() <= 10 && val.matches('^[A-Z0-9]+$');
    }

    function isValidTrainNumber(val) {
      return val is string && val.size() >= 4 && val.size() <= 10 && val.matches('^[A-Z0-9]+$');
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'homeStation', 'preferredClass', 'preferredQuota', 'theme', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'homeStation', 'preferredClass', 'preferredQuota', 'theme', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && (data.uid == request.auth.uid || isBootstrapAdmin())
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isValidStationCode(data.homeStation)
        && isValidClass(data.preferredClass)
        && isValidQuota(data.preferredQuota)
        && data.theme is string && data.theme.size() <= 10 && data.theme in ['dark', 'light']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'telegramHandle', 'emailAlerts', 'telegramAlerts', 'browserAlerts', 'windowReminderMinutes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'telegramHandle', 'emailAlerts', 'telegramAlerts', 'browserAlerts', 'windowReminderMinutes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && (data.uid == request.auth.uid || isBootstrapAdmin())
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.telegramHandle is string && data.telegramHandle.size() <= 64
        && data.emailAlerts is bool
        && data.telegramAlerts is bool
        && data.browserAlerts is bool
        && data.windowReminderMinutes is int && data.windowReminderMinutes >= 5 && data.windowReminderMinutes <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackedTrain(data, trackId) {
      return data.keys().hasAll([
          'id', 'userId', 'trainNumber', 'trainName', 'sourceCode', 'destinationCode',
          'travelDate', 'travelClass', 'quota', 'targetStatus', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'trainNumber', 'trainName', 'sourceCode', 'destinationCode',
          'travelDate', 'travelClass', 'quota', 'targetStatus', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == trackId
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isBootstrapAdmin())
        && isValidTrainNumber(data.trainNumber)
        && data.trainName is string && data.trainName.size() >= 2 && data.trainName.size() <= 120
        && isValidStationCode(data.sourceCode)
        && isValidStationCode(data.destinationCode)
        && isValidDateString(data.travelDate)
        && isValidClass(data.travelClass)
        && isValidQuota(data.quota)
        && data.targetStatus is string && data.targetStatus.size() <= 20
        && data.targetStatus in ['AVAILABLE', 'RAC', 'WL_IMPROVEMENT', 'WINDOW_OPEN']
        && data.notes is string && data.notes.size() <= 300
        && data.status is string && data.status.size() <= 16 && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAlert(data, alertId) {
      return data.keys().hasAll([
          'id', 'userId', 'trainNumber', 'title', 'message', 'category', 'severity', 'isRead', 'sourceType', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'trainNumber', 'title', 'message', 'category', 'severity', 'isRead', 'sourceType', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == alertId
        && isValidId(data.userId)
        && (data.userId == request.auth.uid || isBootstrapAdmin())
        && isValidTrainNumber(data.trainNumber)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && data.category is string && data.category.size() <= 24
        && data.category in ['AVAILABILITY', 'WAITLIST', 'BOOKING_WINDOW', 'RUNNING_STATUS']
        && data.severity is string && data.severity.size() <= 16
        && data.severity in ['info', 'warning', 'critical']
        && data.isRead is bool
        && data.sourceType is string && data.sourceType.size() <= 24
        && data.sourceType in ['DEMO_SIMULATED', 'AUTHORIZED_API', 'AI_PREDICTION', 'SYSTEM_RULE']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedPrediction(data, predictionId) {
      return data.keys().hasAll([
          'id', 'userId', 'trainNumber', 'trainName', 'travelDate', 'travelClass',
          'quota', 'waitlistType', 'waitlistNumber', 'probability', 'confidenceLevel',
          'recommendation', 'dataSourceLabel', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'trainNumber', 'trainName', 'travelDate', 'travelClass',
          'quota', 'waitlistType', 'waitlistNumber', 'probability', 'confidenceLevel',
          'recommendation', 'dataSourceLabel', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == predictionId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidTrainNumber(data.trainNumber)
        && data.trainName is string && data.trainName.size() >= 2 && data.trainName.size() <= 120
        && isValidDateString(data.travelDate)
        && isValidClass(data.travelClass)
        && isValidQuota(data.quota)
        && data.waitlistType is string && data.waitlistType.size() <= 10
        && data.waitlistType in ['GNWL', 'TQWL', 'RLWL', 'PQWL', 'RAC']
        && data.waitlistNumber is int && data.waitlistNumber >= 0 && data.waitlistNumber <= 999
        && (data.probability is number) && data.probability >= 0 && data.probability <= 100
        && data.confidenceLevel is string && data.confidenceLevel.size() <= 10
        && data.confidenceLevel in ['HIGH', 'MEDIUM', 'LOW']
        && data.recommendation is string && data.recommendation.size() >= 2 && data.recommendation.size() <= 400
        && data.dataSourceLabel is string && data.dataSourceLabel.size() >= 2 && data.dataSourceLabel.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidAdminGrant(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && data.uid == adminId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.grantedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'action', 'target', 'details', 'severity', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'action', 'target', 'details', 'severity', 'createdAt'])
        && isValidId(data.id)
        && data.id == logId
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.target is string && data.target.size() >= 1 && data.target.size() <= 120
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 500
        && data.severity is string && data.severity.size() <= 16 && data.severity in ['info', 'warning', 'critical']
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'homeStation', 'preferredClass', 'preferredQuota', 'theme', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Split Collection for Private PII
      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerified()
          && isValidId(userId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && docId == 'profile'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'telegramHandle', 'emailAlerts', 'telegramAlerts', 'browserAlerts', 'windowReminderMinutes', 'updatedAt'
              ])
            )
          );

        allow delete: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isAdmin());
      }
    }

    match /trackedTrains/{trackId} {
      allow get: if isValidId(trackId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerified()
        && isValidId(trackId)
        && isValidTrackedTrain(incoming(), trackId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(trackId)
        && isValidTrackedTrain(incoming(), trackId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'archived'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['targetStatus', 'notes', 'travelClass', 'quota', 'updatedAt']) ||
              (incoming().status == 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
            )
          )
        );

      allow delete: if isVerified() && isValidId(trackId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /alerts/{alertId} {
      allow get: if isValidId(alertId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerified()
        && isValidId(alertId)
        && isValidUserAlert(incoming(), alertId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(alertId)
        && isValidUserAlert(incoming(), alertId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
          )
        );

      allow delete: if isVerified() && isValidId(alertId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /predictions/{predictionId} {
      allow get: if isValidId(predictionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isVerified()
        && isValidId(predictionId)
        && isValidSavedPrediction(incoming(), predictionId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerified() && isValidId(predictionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminGrant(incoming(), adminId)
        && incoming().grantedAt == request.time;

      allow update: if false;
      allow delete: if isBootstrapAdmin() && isValidId(adminId);
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrapAdmin();

      allow create: if isAdmin()
        && isValidId(logId)
        && isValidAuditLog(incoming(), logId)
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
